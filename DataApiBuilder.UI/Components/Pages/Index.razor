@page "/"

<div class="landing-grid">
    <a href="/nl-query" class="landing-card">
        <div class="landing-icon">
            <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-3 3-3-3z" />
            </svg>
        </div>
        <h2 class="landing-card-title">Natural Language</h2>
        <p class="landing-card-desc">Ask questions in plain English. The AI agent translates your question into a
            structured query and returns a formatted answer with data insights.</p>
            <span class="landing-card-cta">Open →</span>
        </a>
        <a href="/graphql-query" class="landing-card">
            <div class="landing-icon">
                <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18M10 3v18M14 3v18" />
                </svg>
            </div>
            <h2 class="landing-card-title">Query Builder</h2>
            <p class="landing-card-desc">Build structured queries visually. Select fields, add filters, sort results, and
                query the GraphQL API directly to explore invoice data.</p>
                <span class="landing-card-cta">Open →</span>
            </a>
        <a href="/analysis" class="landing-card">
            <div class="landing-icon">
                <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
            </div>
            <h2 class="landing-card-title">Analysis & Charts</h2>
            <p class="landing-card-desc">Ask for data analysis and get a visual chart. The AI agent retrieves real invoice data and returns a bar, pie, or line chart with a summary.</p>
            <span class="landing-card-cta">Open →</span>
        </a>
        </div>
